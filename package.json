{
  "name": "data-url-converter",
  "version": "1.0.2",
  "private": true,
  "license": "MIT",
  "author": "Sarkis Andreyan <sarkis@andreyan.com>",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build:chromium": "tsc && npm run cleanup && vite build --mode chromium",
    "build:edge": "tsc && npm run cleanup && vite build --mode edge",
    "build:gecko": "tsc && npm run cleanup && vite build --mode gecko",
    "cleanup": "rm -rf dist/",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.1.43",
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vite-plugin-zip-pack": "^1.2.4"
  },
  "engines": {
    "node": "^24.17.0"
  }
}
